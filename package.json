{
  "name": "company-desk",
  "version": "0.1.0",
  "private": true,
  "description": "企业交付工作台（valimart harness）— 基于 @deepseek-ai/dsh 内核（内置公司补丁）的公司网关服务端与桌面客户端",
  "type": "module",
  "scripts": {
    "kernel": "node scripts/install-kernel.mjs",
    "kernel:check": "node scripts/install-kernel.mjs --check",
    "kernel:discover": "node scripts/kernel/update.mjs discover",
    "kernel:prepare": "node scripts/kernel/update.mjs prepare",
    "kernel:publish": "node scripts/kernel/update.mjs publish",
    "client:publish": "node scripts/client/publish.mjs",
    "setup": "node scripts/setup-profile.mjs",
    "build": "node scripts/build-client.mjs",
    "build:watch": "node scripts/build-client.mjs --watch",
    "icon": "node scripts/make-icon.mjs",
    "server": "node server/src/index.js",
    "client": "node scripts/launch.mjs",
    "desktop": "node scripts/launch.mjs --desktop",
    "dev": "node scripts/launch.mjs --with-server --desktop",
    "dist:client": "node scripts/build-payload.mjs && node scripts/build-client-installer.mjs",
    "dist:gateway": "node scripts/build-gateway-installer.mjs",
    "dist:gateway:linux": "node scripts/build-gateway-linux.mjs",
    "dist": "npm run dist:client && npm run dist:gateway",
    "backup": "node scripts/backup-gateway.mjs",
    "probe:channels": "node scripts/probe-channels.mjs",
    "test": "node --test server/test/*.test.js scripts/test/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0"
  }
}
